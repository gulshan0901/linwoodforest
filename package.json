{
  "name": "linwood-forest-redesign",
  "version": "1.0.0",
  "description": "Phase 1 static redesign for Linwood Forest Insurance Group.",
  "main": "index.js",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "type-check": "tsc --noEmit",
    "audit:a11y": "node scripts/a11y-smoke.mjs",
    "audit:lighthouse": "lhci autorun --config=lhci.config.cjs",
    "audit:redirects": "node scripts/audit-redirects.mjs",
    "audit:seo": "node scripts/audit-seo-coverage.mjs",
    "launch:check": "npm run format:check && npm run lint && npm run type-check && npm run build",
    "prepare": "husky"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/noto-sans-sc": "^5.3.0",
    "@mui/icons-material": "^5.15.15",
    "@mui/material": "^5.15.15",
    "@mui/material-nextjs": "^9.4.0",
    "next": "^15.0.3",
    "next-intl": "^4.14.8",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.5.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@lhci/cli": "^0.15.1",
    "@types/node": "^18.19.39",
    "@types/react": "^18.3.8",
    "@types/react-dom": "^18.3.2",
    "eslint": "^9.0.0",
    "eslint-config-next": "^15.0.3",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "playwright": "^1.63.0",
    "prettier": "^3.9.9"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix"
    ],
    "*.{ts,tsx,js,jsx,json,css,md}": [
      "prettier --write"
    ]
  }
}
